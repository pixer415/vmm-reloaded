#!/usr/bin/env bash
# Report whether every piece the "3D acceleration" / "OpenGL" checkboxes depend
# on is actually present. Run it from the terminal icon in the web UI when a
# guest refuses to boot, so you can tell which layer is missing.

QEMU="${QEMU:-qemu-system-x86_64}"
URI="${LIBVIRT_DEFAULT_URI:-qemu:///system}"

ok()   { printf '  \033[32mok\033[0m    %s\n' "$*"; }
bad()  { printf '  \033[31mFAIL\033[0m  %s\n' "$*"; }
note() { printf '        %s\n' "$*"; }

echo
echo "DRM render node"
if [ ! -d /dev/dri ]; then
  bad "/dev/dri is missing"
  note "add '- /dev/dri' to the devices section of your compose file"
else
  found=0
  for node in /dev/dri/renderD*; do
    [ -c "$node" ] || continue
    found=1
    name="${node##*/}"
    vendor="$(cat "/sys/class/drm/$name/device/vendor" 2>/dev/null || echo unknown)"
    if { exec {fd}<>"$node"; } 2>/dev/null; then
      { exec {fd}>&-; } 2>/dev/null
      ok "$node is readable (PCI vendor $vendor)"
    else
      bad "$node exists but cannot be opened (permissions)"
    fi
  done
  [ "$found" = 1 ] || bad "/dev/dri holds no renderD* node"
fi
NODE=""
if [ -r /run/virt-reloaded/rendernode ]; then
  NODE="$(cat /run/virt-reloaded/rendernode)"
  note "selected: $NODE"
fi

echo
echo "QEMU"
if ! command -v "$QEMU" >/dev/null 2>&1; then
  bad "$QEMU is not installed"
else
  ok "$("$QEMU" --version | head -1)"
  if "$QEMU" -device help 2>&1 | grep -q "virtio-vga-gl"; then
    ok "virtio-vga-gl device present (qemu-system-modules-opengl)"
  else
    bad "virtio-vga-gl is missing - install qemu-system-modules-opengl"
  fi
  if "$QEMU" -display help 2>&1 | grep -q "egl-headless"; then
    ok "egl-headless display present"
  else
    bad "egl-headless is missing - install qemu-system-modules-opengl"
  fi
  # QEMU's -device list names no SPICE device, so look for the module files the
  # spice package installs, and for qxl, which ships inside it.
  if compgen -G "/usr/lib/*/qemu/ui-spice-core.so" >/dev/null 2>&1 \
     || "$QEMU" -device help 2>&1 | grep -qi "qxl"; then
    ok "SPICE support present (qemu-system-modules-spice)"
  else
    note "SPICE not detected - only matters if you want SPICE displays; egl-headless does not need it"
  fi
fi

echo
echo "Host GL stack"
for lib in libvirglrenderer.so.1 libEGL.so.1 libgbm.so.1; do
  if ldconfig -p 2>/dev/null | grep -q "$lib"; then
    ok "$lib"
  else
    bad "$lib is missing"
  fi
done
if command -v eglinfo >/dev/null 2>&1; then
  renderer="$(eglinfo -B 2>/dev/null | grep -m1 -i "OpenGL renderer" | cut -d: -f2- | sed 's/^ *//')"
  [ -n "$renderer" ] && ok "EGL renderer: $renderer" || note "eglinfo produced no renderer string"
fi

# The libraries being present does not mean EGL will come up on this node. Ask
# QEMU to do the exact thing libvirt will ask of it, and read the answer.
if [ -n "$NODE" ] && command -v "$QEMU" >/dev/null 2>&1; then
  # -machine none starts nothing but the display; "quit" on the monitor makes
  # QEMU exit the moment that display is up, rather than idling to the timeout.
  probe="$(echo quit | timeout 20 "$QEMU" -machine none -nodefaults \
             -display "egl-headless,rendernode=$NODE" \
             -monitor stdio 2>&1)"
  # Mesa prints this on AMD whenever kcmp() is unavailable, which is the normal
  # state inside a container. It is noise, not a failure.
  probe_real="$(grep -v 'os_same_file_description\|bad things may happen' <<< "$probe")"
  if grep -qi 'egl' <<< "$probe_real" \
     && grep -qiE 'fail|error|unable|not available|no such' <<< "$probe_real"; then
    bad "EGL will not start on $NODE - guests with 3D will fail to boot"
    note "$(grep -iE 'egl|drm|render' <<< "$probe_real" | head -3)"
  elif grep -qiE 'is not a valid|invalid option|unknown display' <<< "$probe_real"; then
    note "could not run the EGL probe on this QEMU; skipped"
  else
    ok "EGL starts on $NODE - egl-headless initialises cleanly"
    if grep -q 'os_same_file_description' <<< "$probe"; then
      note "(Mesa's amdgpu os_same_file_description notice is expected in a container)"
    fi
  fi
fi

echo
echo "libvirt"
if ! command -v virsh >/dev/null 2>&1; then
  bad "virsh is not installed"
elif ! virsh -c "$URI" version >/dev/null 2>&1; then
  bad "cannot connect to $URI"
  note "set LIBVIRTD=Y, or check the socket bind mount in your compose file"
else
  ok "connected to $URI"
  caps="$(virsh -c "$URI" domcapabilities 2>/dev/null)"
  if grep -q "virtio" <<< "$(sed -n '/<video/,/<\/video>/p' <<< "$caps")"; then
    ok "libvirt reports a virtio video model"
  else
    bad "libvirt does not report a virtio video model"
  fi
  # Match only an active setting. Ubuntu's stock qemu.conf carries a commented
  # example of this key near the top, which is not the same thing at all.
  acl="$(grep -m1 '^[[:space:]]*cgroup_device_acl' /etc/libvirt/qemu.conf 2>/dev/null)"
  if [ -z "$acl" ]; then
    bad "no active cgroup_device_acl in /etc/libvirt/qemu.conf"
    note "the managed block should have been written at startup; check the app log"
  elif grep -q "/dev/dri/render" <<< "$acl"; then
    ok "qemu.conf grants a render node to guests"
  else
    bad "cgroup_device_acl is set but lists no /dev/dri render node"
    note "$(cut -c1-150 <<< "$acl")"
  fi

  if grep -q '^[[:space:]]*namespaces[[:space:]]*=[[:space:]]*\[\]' /etc/libvirt/qemu.conf 2>/dev/null; then
    ok "qemu.conf is in container mode (namespaces disabled)"
  else
    bad "namespaces are still enabled; libvirt will try to build a private /dev"
  fi
fi

echo
echo "Run 'virt-3d list' to see which domains have acceleration wired up."
echo
