#!/usr/bin/env python3
"""A window for turning guest GPU acceleration on and off.

Everything here is a front end to the virt-3d command; the command stays the
single source of truth for what the XML should look like, and this only has to
present it. It opens as its own Broadway window alongside virt-manager, so that
nobody has to meet tmux to switch a VM to hardware rendering.
"""

import json
import re
import subprocess
import threading

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk, Pango  # noqa: E402

VIRT_3D = "/usr/local/bin/virt-3d"
GPU_CHECK = "/usr/local/bin/virt-gpu-check"
RENDERNODE_FILE = "/run/virt-reloaded/rendernode"
ANSI = re.compile(r"\x1b\[[0-9;]*m")


def run(argv):
    """Run one of our own CLIs. Returns (ok, stdout, stderr)."""
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError) as exc:
        return False, "", str(exc)
    return proc.returncode == 0, proc.stdout, proc.stderr.strip()


class AccelWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="GPU Acceleration")
        self.set_default_size(660, 540)
        self.set_border_width(0)
        self._syncing = False

        header = Gtk.HeaderBar(title="GPU Acceleration", show_close_button=True)
        header.set_subtitle("Hardware rendering for your virtual machines")
        self.set_titlebar(header)

        refresh = Gtk.Button.new_from_icon_name("view-refresh-symbolic", Gtk.IconSize.BUTTON)
        refresh.set_tooltip_text("Reload the list")
        refresh.connect("clicked", lambda _b: self.reload())
        header.pack_end(refresh)

        diagnose = Gtk.Button(label="Check GPU")
        diagnose.connect("clicked", self.on_diagnose)
        header.pack_start(diagnose)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(outer)

        self.banner = Gtk.Label(xalign=0)
        self.banner.set_line_wrap(True)
        self.banner.set_margin_top(14)
        self.banner.set_margin_bottom(14)
        self.banner.set_margin_start(16)
        self.banner.set_margin_end(16)
        outer.pack_start(self.banner, False, False, 0)
        outer.pack_start(Gtk.Separator(), False, False, 0)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        outer.pack_start(scroller, True, True, 0)

        self.rows = Gtk.ListBox()
        self.rows.set_selection_mode(Gtk.SelectionMode.NONE)
        scroller.add(self.rows)

        outer.pack_start(Gtk.Separator(), False, False, 0)
        self.status = Gtk.Label(xalign=0)
        self.status.set_line_wrap(True)
        self.status.set_margin_top(10)
        self.status.set_margin_bottom(10)
        self.status.set_margin_start(16)
        self.status.set_margin_end(16)
        outer.pack_start(self.status, False, False, 0)

        self.reload()

    # ---------- data ----------

    def rendernode(self):
        try:
            with open(RENDERNODE_FILE) as handle:
                return handle.read().strip()
        except OSError:
            return ""

    def set_status(self, text, tone="normal"):
        colours = {"normal": None, "good": "#1b7a6e", "bad": "#a02742"}
        colour = colours.get(tone)
        if colour:
            self.status.set_markup(
                '<span foreground="%s">%s</span>' % (colour, GLib.markup_escape_text(text))
            )
        else:
            self.status.set_text(text)

    def reload(self):
        for child in self.rows.get_children():
            self.rows.remove(child)

        node = self.rendernode()
        if node:
            self.banner.set_markup(
                "Rendering on <b>%s</b>. Switch a machine on below, then restart it."
                % GLib.markup_escape_text(node)
            )
        else:
            self.banner.set_markup(
                "<b>No GPU available.</b> Guests will use software rendering. "
                "Press <b>Check GPU</b> to see which piece is missing."
            )

        ok, out, err = run([VIRT_3D, "list", "--json"])
        if not ok:
            self.placeholder("Could not reach libvirt.", err or "virt-3d list failed")
            self.rows.show_all()
            return

        try:
            domains = json.loads(out)
        except ValueError:
            self.placeholder("Could not read the machine list.", out[:300])
            self.rows.show_all()
            return

        if not domains:
            self.placeholder(
                "No virtual machines yet.",
                "Create one in Virtual Machine Manager, then come back here.",
            )
        else:
            for dom in domains:
                self.rows.add(self.build_row(dom))

        self.rows.show_all()
        self.set_status("")

    def placeholder(self, title, detail):
        row = Gtk.ListBoxRow(activatable=False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_margin_top(28)
        box.set_margin_bottom(28)
        box.set_margin_start(16)
        box.set_margin_end(16)
        head = Gtk.Label(xalign=0.5)
        head.set_markup("<b>%s</b>" % GLib.markup_escape_text(title))
        sub = Gtk.Label(label=detail, xalign=0.5)
        sub.set_line_wrap(True)
        sub.get_style_context().add_class("dim-label")
        box.pack_start(head, False, False, 0)
        box.pack_start(sub, False, False, 0)
        row.add(box)
        return self.rows.add(row)

    def build_row(self, dom):
        row = Gtk.ListBoxRow(activatable=False)
        line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        line.set_margin_top(10)
        line.set_margin_bottom(10)
        line.set_margin_start(16)
        line.set_margin_end(16)

        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        name = Gtk.Label(xalign=0)
        name.set_markup("<b>%s</b>" % GLib.markup_escape_text(dom["name"]))
        name.set_ellipsize(Pango.EllipsizeMode.END)
        text.pack_start(name, False, False, 0)

        bits = []
        bits.append("video: %s" % (dom.get("video") or "none"))
        if dom.get("accel3d") and dom.get("egl_headless"):
            bits.append("accelerated")
        elif dom.get("accel3d") or dom.get("egl_headless"):
            bits.append("partly configured")
        displays = ", ".join(d["type"] for d in dom.get("displays") or [])
        bits.append("display: %s" % (displays or "none"))
        if dom.get("running"):
            bits.append("running")

        sub = Gtk.Label(label="  ·  ".join(bits), xalign=0)
        sub.set_ellipsize(Pango.EllipsizeMode.END)
        sub.get_style_context().add_class("dim-label")
        text.pack_start(sub, False, False, 0)

        line.pack_start(text, True, True, 0)

        switch = Gtk.Switch()
        switch.set_valign(Gtk.Align.CENTER)
        switch.set_tooltip_text("Render this machine on the GPU")
        self._syncing = True
        switch.set_active(bool(dom.get("accel3d") and dom.get("egl_headless")))
        self._syncing = False
        switch.connect("notify::active", self.on_toggle, dom)
        line.pack_end(switch, False, False, 0)

        row.add(line)
        return row

    # ---------- actions ----------

    def on_toggle(self, switch, _param, dom):
        if self._syncing:
            return
        wanted = switch.get_active()
        verb = "enable" if wanted else "disable"
        switch.set_sensitive(False)
        self.set_status(
            "%s acceleration for %s…" % ("Turning on" if wanted else "Turning off", dom["name"])
        )

        def work():
            ok, _out, err = run([VIRT_3D, verb, dom["name"]])
            GLib.idle_add(done, ok, err)

        def done(ok, err):
            switch.set_sensitive(True)
            if not ok:
                self._syncing = True
                switch.set_active(not wanted)
                self._syncing = False
                self.set_status(err or "virt-3d %s failed" % verb, "bad")
                return
            state = "on" if wanted else "off"
            if dom.get("running"):
                self.set_status(
                    "Acceleration %s for %s. Restart the machine to apply it."
                    % (state, dom["name"]),
                    "good",
                )
            else:
                self.set_status(
                    "Acceleration %s for %s. It applies at the next start."
                    % (state, dom["name"]),
                    "good",
                )
            self.reload()
            return False

        threading.Thread(target=work, daemon=True).start()

    def on_diagnose(self, _button):
        self.set_status("Checking the GPU…")

        def work():
            _ok, out, err = run([GPU_CHECK])
            GLib.idle_add(show, ANSI.sub("", out) + ("\n" + err if err else ""))

        def show(text):
            self.set_status("")
            dialog = Gtk.Dialog(title="GPU report", transient_for=self, modal=True)
            dialog.add_button("Close", Gtk.ResponseType.CLOSE)
            dialog.set_default_size(680, 520)

            view = Gtk.TextView(editable=False, cursor_visible=False, monospace=True)
            view.set_left_margin(12)
            view.set_right_margin(12)
            view.set_top_margin(12)
            view.get_buffer().set_text(text.strip() or "virt-gpu-check produced no output")

            scroller = Gtk.ScrolledWindow()
            scroller.add(view)
            box = dialog.get_content_area()
            box.pack_start(scroller, True, True, 0)
            dialog.show_all()
            dialog.run()
            dialog.destroy()
            return False

        threading.Thread(target=work, daemon=True).start()


def main():
    win = AccelWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
